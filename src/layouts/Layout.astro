---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import SwitchDark from '../components/UI/SwitchDark.astro';

interface Props {
  title: string;
}

const { title } = Astro.props;
---
<!doctype html>
<html lang="es" class="h-full overflow-hidden">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Serif:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;1,100;1,200;1,300;1,400;1,500;1,600;1,700&family=Iceberg&display=swap" rel="stylesheet">
    <title>{title}</title>
    <ClientRouter />
  </head>

  <body class="m-0 p-0 w-screen h-screen flex flex-col overflow-hidden bg-background-theme text-text-theme">
  <div class="absolute top-0 z-[-2] h-full w-full bg-[radial-gradient(100%_50%_at_50%_0%,rgba(0,163,255,0.13)_0,rgba(0,163,255,0)_50%,rgba(0,163,255,0)_100%)] pointer-events-none"></div>

  <header class="w-full shrink-0 border-b border-solid [border-image:linear-gradient(to_right,transparent,gray,transparent)1] z-20">
    <div class="container mx-auto px-4 max-w-6xl py-3 flex flex-row justify-between items-center">
      <div class="flex flex-row items-center gap-3 ">
        <div class="absolute -z-10 w-10 h-8 rounded-full bg-cyan-500/90 dark:bg-red-300 blur-md scale-100 animate-pulse"></div>
        <img src="/logo.webp" alt="Tecnoconce Logo" class="w-10 h-auto pointer-events-none select-none">
        <a href="/" class="text-xl font-iceberg text-primary-theme pointer-events-none select-none">TECNOCONCE</a>
      </div>

      <nav class="flex flex-row gap-6 md:gap-10">
        <a href="/" class="transition-colors">Inicio</a>
        <a href="/servicios" class="transition-colors">Servicios</a>
        <a href="/contacto" class="transition-colors">Contacto</a>
        <a href="/faq" class="transition-colors">Preguntas frecuentes</a>
      </nav>
      <SwitchDark />
    </div>
    </header>

    <main class="flex-1 relative overflow-hidden">
      <slot />
    </main>

    <footer class="w-full shrink-0 border-t border-black/5">
      <div class="container mx-auto px-4 max-w-6xl py-3 text-center">
        <p class="text-sm">
          El mejor servicio técnico de Concepción.
        </p>
      </div>
    </footer>
  </body>
</html>