---
import '../../styles/global.css';
import Card from '../UI/Card.astro';
---

<main transition:animate="fade">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-5xl w-full">
        <a href="/servicios/cambios-led" class="hover:bg-primary-theme" data-target="servtec">
            <Card 
                image="../imagenes/cat-servtec.webp" 
                title="Servicio Técnico" 
                description="Reparación de aparatos electrónicos, Televisores, Equipos de sonido." 
            />
        </a>

        <a href="/servicios/formateo" class="hover:bg-primary-theme" data-target="servcomp">
            <Card 
                image="../imagenes/cat-servcomp.webp" 
                title="Servicios Computacionales" 
                description="Formateos, Cambios de disco duro (M.2 / SSD / HDD), Mantención a profundidad + Cambio de pasta térmica." 
            />
        </a>    
        
    </div>
</main>